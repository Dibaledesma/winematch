# Copia este archivo a .env (o exporta las variables) y ajusta los valores.
# NUNCA subas .env al repositorio: va en .gitignore.

# Entorno: dev | production  (production activa cookies Secure y oculta errores)
APP_ENV=dev

# Base de datos: sqlite (por defecto, sin servidor) o mysql
DB_DRIVER=sqlite
DB_PATH=data/winematch.sqlite3

# Solo con DB_DRIVER=mysql (obligatorios en ese caso):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=winematch
# DB_USER=winematch
# DB_PASS=cambia-esto
