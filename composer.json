{
  "name": "dibaledesma/winematch",
  "description": "Maridador de vinos para restaurantes. Version 2, endurecida, del proyecto final DAW (2025).",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "WineMatch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WineMatch\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "seed": "php database/seed.php",
    "serve": "php -S 127.0.0.1:8099 -t public"
  },
  "config": {
    "process-timeout": 600
  }
}
